PORT=8000
# Neon connection for application reads/writes and Drizzle (keep sslmode=require).
DATABASE_URL=
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
# Google Cloud OAuth client type: Web application.
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded 32-byte key for AES-256-GCM refresh-token encryption.
TOKEN_ENCRYPTION_KEY=
